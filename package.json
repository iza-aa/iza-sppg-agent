    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "grammy": "^1.35.0",
    "pdfkit": "^0.16.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.3",
